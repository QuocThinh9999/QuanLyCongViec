# Giữ nguyên các giá trị PostgreSQL trong .env hiện có của bạn.
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=prefer
PGCONNECT_TIMEOUT=10
PGAPPNAME=quan_ly_cong_viec
# Nếu thiếu SECRET_KEY, ứng dụng tạo khóa riêng trong instance/secret_key.
# Khi triển khai HTTPS, đặt SESSION_COOKIE_SECURE=1.
